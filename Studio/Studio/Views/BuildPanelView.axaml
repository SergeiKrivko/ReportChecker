<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReportChecker.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReportChecker.Studio.Views.BuildPanelView"
             x:DataType="vm:BuildPanelViewModel">

    <Panel>
        <Button Command="{Binding RunBuild}"
                IsVisible="{Binding !IsProgress}">
            Собрать
        </Button>
        <Button Command="{Binding CancelBuild}" Classes="Danger"
                IsVisible="{Binding IsProgress}">
            Отменить
        </Button>
    </Panel>

</UserControl>