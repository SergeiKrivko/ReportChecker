<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReportChecker.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ReportChecker.Studio.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReportChecker.Studio.Views.IssueView"
             x:DataType="vm:IssueViewModel"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <converters:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
        <converters:IssueColorConverter x:Key="IssueColorConverter" />
    </UserControl.Resources>

    <Button Command="{Binding SelectIssue}" CornerRadius="0" HorizontalAlignment="Stretch">
        <Grid RowDefinitions="Auto Auto" ColumnDefinitions="Auto * Auto">
            <PathIcon Grid.RowSpan="2"
                      Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                      Foreground="{Binding Issue.Issue, Converter={StaticResource IssueColorConverter}}"
                      Margin="0 0 5 0" />
            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Issue.Issue.Title}" Margin="2" />
            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Issue.Issue.Chapter}" Margin="2" FontSize="12" />
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="12" Height="12" CornerRadius="6"
                    VerticalAlignment="Center" Background="{DynamicResource PrimaryColor}" Margin="5"
                    IsVisible="{Binding !Issue.Issue.IsRead}"/>
        </Grid>
    </Button>

</UserControl>