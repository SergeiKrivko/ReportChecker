<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReportChecker.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ReportChecker.Studio.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReportChecker.Studio.Views.CommentsView"
             x:DataType="vm:CommentsViewModel">

    <Grid RowDefinitions="Auto * Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" Spacing="5">
            <Button Command="{Binding DeselectIssue}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <LucideIcon Kind="ChevronLeft" />
                    <TextBlock>Назад</TextBlock>
                </StackPanel>
            </Button>
            <Button Command="{Binding MarkIssueAsFixed}" Classes="Success"
                    IsVisible="{Binding IsOpened}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <LucideIcon Kind="Check" />
                    <!-- <TextBlock>Исправлена</TextBlock> -->
                </StackPanel>
            </Button>
            <Button Command="{Binding CloseIssue}" Classes="Danger"
                    IsVisible="{Binding IsOpened}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <LucideIcon Kind="X" />
                    <!-- <TextBlock>Закрыть</TextBlock> -->
                </StackPanel>
            </Button>
            <Button Command="{Binding ReopenIssue}" Classes="Accent"
                    IsVisible="{Binding !IsOpened}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <LucideIcon Kind="CircleAlert" />
                    <!-- <TextBlock>Переоткрыть</TextBlock> -->
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenInBrowser}">
                <LucideIcon Kind="ExternalLink" />
            </Button>
            <Button Command="{Binding GoToCode}">
                <LucideIcon Kind="FileSymlink" />
            </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding CommentViewModels}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:CommentViewModel">
                        <views:CommentView DataContext="{Binding .}" />
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource CanvasColor}" CornerRadius="6" Margin="5">
            <Grid ColumnDefinitions="* Auto" Margin="5">
                <TextBox AcceptsReturn="True" MaxHeight="300" TextWrapping="Wrap"
                         Text="{Binding CommentContent, Mode=TwoWay}" />
                <Button Grid.Column="1" Classes="Accent" Margin="5 0 0 0"
                        Width="32" Height="32" Padding="6" CornerRadius="16" Command="{Binding SendComment}">
                    <LucideIcon Kind="Send" Size="20" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
    </Grid>

</UserControl>