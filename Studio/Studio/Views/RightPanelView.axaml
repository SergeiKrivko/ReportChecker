<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReportChecker.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ReportChecker.Studio.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReportChecker.Studio.Views.RightPanelView"
             x:DataType="vm:RightPanelViewModel">

    <StackPanel Orientation="Horizontal">
        <StackPanel Orientation="Vertical" Spacing="5" Margin="2">
            <ToggleButton Command="{Binding ActivateFileSystem}"
                          IsChecked="{Binding IsFileSystemActive}">
                <PathIcon Data="{StaticResource IconDirectory}" />
            </ToggleButton>
            <ToggleButton Command="{Binding ActivateIssues}"
                          IsChecked="{Binding IsIssuesActive}">
                <PathIcon Data="{StaticResource IconShieldAlert}" />
            </ToggleButton>
            <StackPanel.Styles>
                <Style Selector="ToggleButton">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                </Style>
            </StackPanel.Styles>
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1 0 0 0" IsVisible="{Binding IsOpen}">
            <Panel Width="{Binding PanelWidth, Mode=OneWay}">
                <ContentControl Content="{Binding ActiveViewModel}" />
                <views:ResizerView HorizontalAlignment="Right" Orientation="Vertical"
                                   CurrentSize="{Binding PanelWidth, Mode=TwoWay}"
                                   Width="8" Background="Transparent" />
            </Panel>
        </Border>
    </StackPanel>

</UserControl>