<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ReportChecker.Studio.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ReportChecker.Studio.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReportChecker.Studio.Views.RightPanelView"
             x:DataType="vm:RightPanelViewModel">

    <Grid ColumnDefinitions="Auto *" Width="{Binding PanelWidth, Mode=OneWay}">
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0 0 1 0">
            <StackPanel Orientation="Vertical" Spacing="5" Margin="2">
                <ToggleButton Command="{Binding ActivateFileSystem}"
                              IsChecked="{Binding IsFileSystemActive}">
                    <PathIcon Data="{StaticResource IconDirectory}" />
                </ToggleButton>
                <ToggleButton Command="{Binding ActivateIssues}"
                              IsChecked="{Binding IsIssuesActive}">
                    <PathIcon Data="{StaticResource IconShieldAlert}" />
                </ToggleButton>
                <StackPanel.Styles>
                    <Style Selector="ToggleButton">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                    </Style>
                </StackPanel.Styles>
            </StackPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding ActiveViewModel}" />
        <views:ResizerView Grid.Column="1" HorizontalAlignment="Right" Orientation="Vertical" 
                           CurrentSize="{Binding PanelWidth, Mode=TwoWay}" 
                           Width="8" Background="Transparent" />
    </Grid>

</UserControl>