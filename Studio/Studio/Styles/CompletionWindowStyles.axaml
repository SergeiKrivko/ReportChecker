<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:codeCompletion="clr-namespace:AvaloniaEdit.CodeCompletion;assembly=AvaloniaEdit">

    <Style Selector="codeCompletion|CompletionWindow">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MaxHeight" Value="400" />
    </Style>
    <Style Selector="codeCompletion|CompletionListBox">
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,Monospace,Ubuntu Mono" />
    </Style>
    <Style Selector="codeCompletion|CompletionListBox :is(ListBoxItem)">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</Styles>