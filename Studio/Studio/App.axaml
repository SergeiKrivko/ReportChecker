<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaluxUi="clr-namespace:AvaluxUI;assembly=AvaluxUI.Avalonia"
             x:Class="ReportChecker.Studio.App"
             RequestedThemeVariant="Default">
  
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaluxUI.Avalonia/Colors.axaml"></ResourceInclude>
                <ResourceInclude Source="avares://AvaluxUI.Avalonia/Icons.axaml"></ResourceInclude>
                <!-- <ResourceInclude Source="Styles/Icons.axaml"></ResourceInclude> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="Styles/CompletionWindowStyles.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <avaluxUi:AvaluxUIStyles />

    </Application.Styles>
</Application>